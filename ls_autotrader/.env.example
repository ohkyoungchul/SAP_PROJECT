# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (copy .env.example .env)
# .env 에는 비밀값이 들어가므로 절대 공유하거나 저장소에 올리지 마세요.

# ── 매매용 키: 모의투자 App Key / Secret Key (주문·잔고) ──
LS_APPKEY=
LS_APPSECRET=
# LS증권 HTS 로그인 ID (서버저장 조건식 목록 t1866 조회에 사용)
LS_USER_ID=

# ── 조회 전용 키: 실전 App Key / Secret Key (선택) ──
# 모의투자 키로 조건검색이 안 될 때만 넣으세요. 실행 시 "모의투자에서는 해당업무가
# 제공되지 않습니다" 오류가 나면 필요합니다. 이 키는 조건검색과 현재가 조회에만 쓰이고
# 주문에는 절대 쓰이지 않습니다. 이 키를 넣으면 실시간 조건검색은 실전 서버(9443)로 받습니다.
# LS_DATA_APPKEY=
# LS_DATA_APPSECRET=

# ── 실행 모드 ──
# paper = 모의투자, real = 실거래
TRADING_MODE=paper
# 실거래로 바꾸려면 아래 문구까지 정확히 넣어야 실행됩니다.
# REAL_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY
# true 이면 신호/판단만 로그로 남기고 주문은 보내지 않습니다.
DRY_RUN=true

# ── 조건식 (HTS 에서 서버에 저장한 조건식) ──
CONDITION_NAME=떡상이
# 이름이 겹치면 query_index 로 지정 (python -m autotrader --list-conditions 로 확인)
# CONDITION_INDEX=

# ── 매매 규칙 ──
BUY_AMOUNT=100000
MAX_POSITIONS=10
TAKE_PROFIT_PCT=10
STOP_LOSS_PCT=3
# 신규 매수 허용 시간 (익절/손절 감시는 시간과 관계없이 계속)
BUY_START=09:00
BUY_END=15:15
# 같은 날 이미 매수했던 종목을 다시 매수할지
REBUY_SAME_DAY=false
# 매수할 조건검색 신호 구분 (N=진입, R=재진입 / O=이탈은 매수하지 않음)
BUY_JOB_FLAGS=N,R
# 시작 시점에 이미 조건을 만족하는 종목도 매수할지
BUY_INITIAL_MATCHES=false

# ── 감시 주기 (초) ──
PRICE_POLL_SEC=1
BALANCE_POLL_SEC=2
BUY_FILL_TIMEOUT_SEC=60
SELL_RETRY_SEC=20

# ── 기타 ──
DATA_DIR=data
# 주문 시장 (CSPAT00601 MbrNo): KRX 또는 NXT. 모의투자는 KRX 사용
ORDER_MBR_NO=KRX
# 시작 시 '모의투자 키가 맞는지' 확인을 건너뛰려면 true (권장하지 않음, REAL_TRADING_CONFIRM 도 필요)
# SKIP_ENV_CHECK=false
# 접속 주소를 직접 지정하려면 (기본값은 자동. 보통은 건드리지 마세요)
# WebSocket 포트는 조건검색 키와 맞아야 합니다: 모의투자 키 29443 / 실전 키(LS_DATA_APPKEY 포함) 9443
# LS_REST_BASE=https://openapi.ls-sec.co.kr:8080
# LS_WS_URL=wss://openapi.ls-sec.co.kr:29443/websocket
