# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (copy .env.example .env)
# .env 에는 비밀값이 들어가므로 절대 공유하거나 저장소에 올리지 마세요.

# ── LS증권 OPEN API 인증 (모의투자용 App Key / Secret Key) ──
LS_APPKEY=
LS_APPSECRET=
# LS증권 로그인 ID (서버저장 조건식 목록 t1866 조회에 사용)
LS_USER_ID=

# ── 실행 모드 ──
# paper = 모의투자, real = 실거래
TRADING_MODE=paper
# 실거래로 바꾸려면 아래 문구까지 정확히 넣어야 실행됩니다.
# REAL_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY
# true 이면 신호/판단만 로그로 남기고 주문은 보내지 않습니다.
DRY_RUN=false

# ── 조건식 (HTS에서 서버에 저장한 조건식) ──
CONDITION_NAME=떡상이
# 이름이 겹치면 query_index 로 지정 (python -m autotrader --list-conditions 로 확인)
# CONDITION_INDEX=

# ── 매매 규칙 ──
BUY_AMOUNT=100000
MAX_POSITIONS=10
TAKE_PROFIT_PCT=10
STOP_LOSS_PCT=3
# 신규 매수 허용 시간 (익절/손절 감시는 시간과 관계없이 계속)
BUY_START=09:00
BUY_END=15:15
# 같은 날 이미 매수했던 종목을 다시 매수할지
REBUY_SAME_DAY=false
# 매수할 조건검색 신호 구분 (N=신규 편입, R=재편입)
BUY_JOB_FLAGS=N,R
# 시작 시점에 이미 조건을 만족하는 종목도 매수할지
BUY_INITIAL_MATCHES=false

# ── 감시 주기 (초) ──
PRICE_POLL_SEC=1
BALANCE_POLL_SEC=3
BUY_FILL_TIMEOUT_SEC=60
SELL_RETRY_SEC=20

# ── 기타 ──
DATA_DIR=data
# 접속 주소를 직접 지정하려면 (기본값은 TRADING_MODE 에 따라 자동)
# LS_REST_BASE=https://openapi.ls-sec.co.kr:8080
# LS_WS_URL=
# 주문 시장 구분 (CSPAT00601 MbrNo). 비우면 필드를 보내지 않습니다.
# ORDER_MBR_NO=
